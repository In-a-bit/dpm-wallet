# ── Service ──────────────────────────────────────────────────────────────────
PORT=8090
LOG_LEVEL=info
# Point this at the mounted volume. Mount the directory, not the file (see README).
DATABASE_PATH=/data/dpm-wallet.sqlite

# ── Inbound authentication ───────────────────────────────────────────────────
# The operator gateway's key *into* this service, sent as X-API-Key.
DPM_WALLET_API_KEY=change-me

# ── Volume encryption ────────────────────────────────────────────────────────
# AES-256 key (64 hex chars, openssl rand -hex 32) for the one secret stored on the
# volume: this install's Turnkey API private key. Losing it loses access to the
# sub-organisation, so keep it wherever the volume's backups are kept.
DPM_WALLET_ENCRYPTION_KEY=

# ── Vault ────────────────────────────────────────────────────────────────────
# "turnkey" is the only accepted value in phase 1. Every address is an account of
# the vault's own HD wallet; externally custodied addresses are not supported.
DPM_WALLET_VAULT_MODE=turnkey

# ── Turnkey ──────────────────────────────────────────────────────────────────
# No credentials here: this install mints its own P-256 API key pair on first
# initialization and dpm-api creates the sub-organisation it governs. Only dpm-api
# holds parent-organization credentials.
TURNKEY_API_URL=https://api.turnkey.com
# Name of the HD wallet created inside this install's sub-organisation.
TURNKEY_WALLET_NAME=dpm-wallet

# ── dpm-api (creates this install's sub-organization) ────────────────────────
DPM_API_BASE_URL=https://dpm-api.example.com
# Set only on a liquidity-provider install, which has no builder secret. When empty the
# RELAYER_BUILDER_API_KEY below identifies the install and its owning builder.
DPM_LP_API_KEY=

# ── relayer-api (the only outbound dependency) ───────────────────────────────
RELAYER_BASE_URL=https://relayer.example.com
# Sent as X-Builder-Api-Private-Key. The app-level X-API-Key is the DPM platform's own
# internal credential and is never sent from here.
RELAYER_BUILDER_API_KEY=

# ── Chain and contracts (what GET /contract-info would return) ───────────────
# The EIP-712 exchange domain name is not configurable: it is fixed by the deployed
# exchange, the SDK owns it, and a boot self-check pins the digest it produces.
CHAIN_ID=137
CONTRACT_COLLATERAL=
CONTRACT_CTF=
CONTRACT_CTF_EXCHANGE=
CONTRACT_PROXY_FACTORY=
CONTRACT_PROXY_IMPL=
CONTRACT_RELAY_HUB=
