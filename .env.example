# ── Service ──────────────────────────────────────────────────────────────────
PORT=8090
LOG_LEVEL=info
# Only api-key-pair.plaintext.json lives here; every table is in Postgres. This value is for
# running on the host; both compose stacks override it with the container's /data volume.
DATA_DIR=./data

# ── Database ─────────────────────────────────────────────────────────────────
# The compose postgres service reads these; DATABASE_URL is what the service itself uses.
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_PORT=5440
POSTGRESQL_DB=dpm_wallet
DATABASE_URL=postgres://postgres:postgres@localhost:5440/dpm_wallet?sslmode=disable
# The test suite creates a throwaway database per test on this server, so point it at a
# local instance and never at anything holding real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5440/postgres?sslmode=disable

# ── Inbound authentication ───────────────────────────────────────────────────
# The operator gateway's key *into* this service, sent as X-API-Key.
DPM_WALLET_API_KEY=change-me

# ── Volume encryption ────────────────────────────────────────────────────────
# AES-256 key (64 hex chars, openssl rand -hex 32) for the one secret stored on the
# volume: this install's Turnkey API private key. Losing it loses access to the
# sub-organisation, so keep it wherever the volume's backups are kept.
DPM_WALLET_ENCRYPTION_KEY=

# ── Vault ────────────────────────────────────────────────────────────────────
# "turnkey" is the only accepted value in phase 1. Every address is an account of
# the vault's own HD wallet; externally custodied addresses are not supported.
DPM_WALLET_VAULT_MODE=turnkey

# ── Turnkey ──────────────────────────────────────────────────────────────────
# No credentials here: this install mints its own P-256 API key pair on first
# initialization and dpm-api creates the sub-organisation it governs. Only dpm-api
# holds parent-organization credentials.
TURNKEY_API_URL=https://api.turnkey.com
# Name of the HD wallet created inside this install's sub-organisation.
TURNKEY_WALLET_NAME=dpm-wallet

# ── dpm-api (creates this install's sub-organization) ────────────────────────
DPM_API_BASE_URL=https://dpm-api.example.com
# Running dpm-api on your own machine? Leave the line above pointing at localhost for
# `npm run dev`; the dev compose stack rewrites it to host.docker.internal on its own, because
# localhost inside a container is the container. Set this only to send the *container* somewhere
# the default does not cover:
# DPM_API_BASE_URL_DOCKER=https://dpm-api.staging.example.com
# Set only on a liquidity-provider install, which has no builder secret. When empty the
# RELAYER_BUILDER_API_KEY below identifies the install and its owning builder.
DPM_LP_API_KEY=

# ── gamma-api (registers a wallet with the DPM platform) ─────────────────────
# A different service from dpm-api above, reached on its own port: POST /custody/users, which
# onboards a custodied address into the platform's user table, lives here rather than there.
GAMMA_API_URL=https://gamma-api.example.com
# Same arrangement as DPM_API_BASE_URL above.
# GAMMA_API_URL_DOCKER=https://gamma-api.staging.example.com
# The app-level X-API-Key, which gamma-api puts in front of every one of its routes. Custody
# onboarding therefore needs *both* this and RELAYER_BUILDER_API_KEY below — the first gets
# past the global gate, the second past the custody group. Either alone is a 401 whose body
# says only "unauthorized", so a half-configured install fails in a way that does not explain
# itself. Must match prediction-go's APP_API_KEY.
APP_API_KEY=

# ── relayer-api ──────────────────────────────────────────────────────────────
RELAYER_BASE_URL=https://relayer.example.com
# Same arrangement as DPM_API_BASE_URL above.
# RELAYER_BASE_URL_DOCKER=https://relayer.staging.example.com
# Sent as X-Builder-Api-Private-Key, both to relayer-api and to gamma-api's custody onboarding.
RELAYER_BUILDER_API_KEY=

# ── Chain and contracts ──────────────────────────────────────────────────────
# Only what the service resolves without asking anyone. The collateral token, the CTF and
# the RelayHub come from the relayer's GET /contract-info, read once at first use.
# The EIP-712 exchange domain name is not configurable: it is fixed by the deployed
# exchange, the SDK owns it, and a boot self-check pins the digest it produces.
CHAIN_ID=137
# EIP-712 verifyingContract for orders.
CONTRACT_CTF_EXCHANGE=
# Both derive a wallet's proxy address locally, before any proxy is deployed.
CONTRACT_PROXY_FACTORY=
CONTRACT_PROXY_IMPL=

