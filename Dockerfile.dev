# syntax=docker/dockerfile:1
#
# DEVELOPMENT image. The production one is Dockerfile.prod, and the difference is entirely in how
# @inabit-com/dpm-sdk arrives: here it is the sibling checkout, compiled from source, so a change
# in ../dpm-sdk reaches the container on the next build with no publish step. Production installs
# the published package and has none of this machinery.
#
# Listens on 0.0.0.0:$PORT (8090 by default); probe GET /v1/health. Every table lives in the
# Postgres database DATABASE_URL names; the only thing on the /data volume is the plaintext API
# key pair backup.
#
# Starting the container migrates the database first (see CMD). That step lives here rather than
# in the service, so it is visible in the image and can be skipped by overriding the command —
# `docker run … node dist/main` starts without touching the schema. Under compose the `migrate`
# service does it instead, and the command is overridden there.

ARG NODE_VERSION=22

# ── Stage 1: the sibling SDK ─────────────────────────────────────────────────
# `@inabit-com/dpm-sdk` is a `file:../dpm-sdk` dependency: a sibling checkout that sits outside
# this build context, which is why a plain `docker build .` used to fail its `npm ci`. It comes
# in as the BuildKit named context `dpm-sdk` — compose supplies it (see `additional_contexts`
# in docker-compose.yml), and by hand it is
#
#     docker build --build-context dpm-sdk=../dpm-sdk .
#
# Only the build inputs are copied, never the sibling's node_modules (1.3G) and never its dist:
# the image compiles the SDK from source, so what ships is what that source says rather than
# whatever was last built on someone's workstation.
FROM node:${NODE_VERSION}-alpine AS sdk

WORKDIR /dpm-sdk

COPY --from=dpm-sdk package.json package-lock.json tsconfig.json tsup.config.ts ./
COPY --from=dpm-sdk scripts/ scripts/
COPY --from=dpm-sdk src/ src/

RUN --mount=type=cache,target=/root/.npm \
    npm ci

# tsup emits dist/, and the `prebuild` hook regenerates src/version.generated.ts on the way.
RUN npm run build

# Node follows the link to its real path before resolving, so the SDK's own imports (viem,
# @turnkey/sdk-server) are looked up in /dpm-sdk/node_modules rather than in /app/node_modules.
# The runtime dependencies have to stay beside it; the build-only ones do not.
RUN npm prune --omit=dev

# ── Stage 2: build the service ───────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# npm resolves the `file:../dpm-sdk` specifier against /app, so the SDK has to be at /dpm-sdk
# before the install runs: `npm ci` points node_modules/@inabit-com/dpm-sdk straight at it.
COPY --from=sdk /dpm-sdk /dpm-sdk

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# nest-cli.json drives the build, selecting tsconfig.build.json. The migrations need no asset
# copying: they are TypeScript classes, so the ordinary compile emits them into dist.
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src/ src/

RUN npm run build

# Drop the dev dependencies from the tree the runtime stage inherits.
RUN npm prune --omit=dev

# ── Stage 3: runtime ─────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS runtime

RUN apk add --no-cache tini

WORKDIR /app

ENV NODE_ENV=production
# Matches the VOLUME declared below. The default in src/config.ts is the same, but a
# developer .env carrying a host-relative DATA_DIR would otherwise follow the source into
# the container and land on /app, which this user cannot write to.
ENV DATA_DIR=/data

COPY package.json ./
# Both halves of the link travel together: node_modules/@inabit-com/dpm-sdk is a symlink to
# /dpm-sdk, so the target has to be in the image or every SDK import fails at startup.
COPY --from=sdk /dpm-sdk /dpm-sdk
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

RUN addgroup -S dpm-wallet && adduser -S dpm-wallet -G dpm-wallet \
    && mkdir -p /data && chown dpm-wallet:dpm-wallet /data

USER dpm-wallet

VOLUME ["/data"]
EXPOSE 8090

ENTRYPOINT ["/sbin/tini", "--"]
# Migrate, then hand the process over to the service. `exec` matters: without it the shell stays
# as tini's child and the service never sees SIGTERM, which would cost the 25s drain on shutdown.
# `&&` matters too — a failed migration must stop the boot rather than start against a stale schema.
CMD ["sh", "-c", "node dist/db/migrate-cli && exec node dist/main"]
