{
  "name": "dpm-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operator-hosted address management and signing service for DPM prediction markets",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:debug": "node --inspect=9240 --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inabit-com/dpm-sdk": "0.2.0-beta.10",
    "@turnkey/sdk-server": "^2",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.38.4",
    "express": "^5.1.0",
    "viem": "^2.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.3",
    "@types/node": "^22",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3"
  }
}
